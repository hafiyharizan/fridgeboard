# -----------------------------------------------------------------------
# Fridgeboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# -----------------------------------------------------------------------

# Supabase (required)
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (recommended for OAuth redirects in production)
# Example: https://fridgeboard.netlify.app
NEXT_PUBLIC_SITE_URL=

# Cron protection (recommended)
# Any strong random string — used to authenticate POST /api/notifications
# Example: openssl rand -base64 32
CRON_SECRET=

# Email notifications via Resend (optional)
# Sign up at https://resend.com — free tier supports 3 000 emails/month
RESEND_API_KEY=re_your_api_key_here
# Must be a verified sender domain in your Resend account
RESEND_FROM_EMAIL=Fridgeboard <noreply@yourdomain.com>

# Telegram notifications (optional)
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=

# Grocery price search (optional)
# Enables automatic price comparison when adding grocery items.
# Get a Google Custom Search JSON API key at https://console.cloud.google.com
GOOGLE_SEARCH_API_KEY=
# Create a Programmable Search Engine at https://programmablesearchengine.google.com
GOOGLE_SEARCH_ENGINE_ID=
